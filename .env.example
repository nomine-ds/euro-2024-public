# Local backend environment. Copy to .env and replace the development key.
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Production uses the Vercel proxy and does not require direct browser CORS.
CORS_ORIGINS=http://localhost:3000
# Replace this dummy value before using admin endpoints.
CACHE_API_KEY=local-development-only-not-a-secret
DATA_DIR=data/raw
CHROMA_DB_PATH=data/chroma_db
# Optional locally; production requires an Upstash Redis TLS connection URL.
REDIS_URL=
# Local Ollama only; configure a reachable server in Railway.
OLLAMA_HOST=http://127.0.0.1:11434

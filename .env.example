# ============================================================
# Euro 2024 Context Zone — Environment Configuration Template
# ============================================================
# Copy this file to `.env` and adjust values for your environment:
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
#
# Never commit the real `.env` file — it may contain secrets.
# ============================================================

# -------- Backend (FastAPI) --------
# Runtime mode: development | production
APP_ENV=development

# Server binding (used by uvicorn in deployment)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS — comma-separated list of allowed origins
# Local dev:  http://localhost:3000
# Production: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000

# Data directory (relative to project root)
DATA_DIR=data/raw

# -------- Frontend (Next.js) --------
# Base URL of the backend API — exposed to browser
# Local dev:  http://127.0.0.1:8000
# Production: https://your-backend.up.railway.app
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# -------- Hudl Bot (RAG) — Optional --------
# LLM provider for the chatbot. Leave empty to use local Ollama.
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=sk-...
# OLLAMA_HOST=http://localhost:11434

# Vector store location (ChromaDB persistent dir)
CHROMA_DB_PATH=data/chroma_db

# -------- Deployment Only --------
# Set these only in production (Railway / Vercel / Docker):
# NODE_ENV=production
# PYTHON_ENV=production